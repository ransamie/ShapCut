# ShapCut Backend — Environment Variables
# Copy this file to .env and edit as needed

# Host and port
HOST=127.0.0.1
PORT=8000

# Max upload file size in bytes (default: 10 GB)
MAX_UPLOAD_BYTES=10737418240

# Whisper default model (tiny/base/small/medium/large-v3)
DEFAULT_MODEL=base

# Optional: OpenAI API key for enhanced analysis (leave blank to use local NLP)
# OPENAI_API_KEY=sk-...

# Optional: LanguageTool remote server URL (leave blank to use local JVM)
# LANGUAGE_TOOL_SERVER=https://api.languagetoolplus.com/v2
